# ==============================
# APP CONFIG
# ==============================
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=https://your-wordpress-domain.com

# ==============================
# DATABASE (PostgreSQL)
# ==============================
DATABASE_URL=postgresql+asyncpg://bot_user:changeme@localhost:5432/solutions_bot

# ==============================
# REDIS
# ==============================
REDIS_URL=redis://localhost:6379/0

# ==============================
# LLM PROVIDERS
# ==============================
# Primary
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Fallback (pick one or both configured, code will try in order)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ==============================
# EMBEDDINGS (OpenAI)
# ==============================
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==============================
# CHROMADB
# ==============================
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=agency_knowledge

# ==============================
# GOOGLE CALENDAR
# ==============================
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google_calendar_service_account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# ==============================
# WHATSAPP CLOUD API (Meta)
# ==============================
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_APP_SECRET=your_app_secret_for_signature_verification
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ==============================
# JWT (Admin Panel Auth)
# ==============================
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================
# ENCRYPTION (sensitive client data at rest)
# ==============================
FIELD_ENCRYPTION_KEY=generate_a_fernet_key_here

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_PER_MINUTE=20

# ==============================
# TEAM NOTIFICATIONS
# ==============================
NOTIFY_WHATSAPP_NUMBER=your_team_whatsapp_number
NOTIFY_EMAIL=team@youragency.com
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password